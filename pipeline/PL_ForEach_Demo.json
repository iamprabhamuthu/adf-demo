{
	"name": "PL_ForEach_Demo",
	"properties": {
		"activities": [
			{
				"name": "loopThruTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ReadTableList",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ReadTableList').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Call_ingestion_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_demo_ingest",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"tablename": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "StoretblSuccess",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Call_ingestion_pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "tablestatus",
								"value": {
									"value": "@{item().table_name} - Success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "StoreTableFailure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Call_ingestion_pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "tablestatus",
								"value": {
									"value": "@{item().table_name} - Failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ReadTableList",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "Select table_name from metadata.table_list",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "pk_sql_server",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"tablename": "customers"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Execute Pipeline1",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "loopThruTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_email_demo_multi_table",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"emailrec": {
							"value": "@pipeline().globalParameters.email_rec",
							"type": "Expression"
						},
						"tablestatus": {
							"value": "@variables('tablestatus')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"variables": {
			"tablestatus": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-15T04:15:34Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}