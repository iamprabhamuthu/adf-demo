				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "CheckSrcCnt",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_email_demo",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tablename": {
							"value": "@pipeline().parameters.tablename",
							"type": "Expression"
						},
						"emailrec": {
							"value": "@pipeline().globalParameters.email_rec",
